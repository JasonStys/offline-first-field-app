<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FieldOps.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FieldOps.App">
    <Application.Resources>
        <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <Color x:Key="Ink">#12212B</Color>
        <Color x:Key="Surface">#F5F7F8</Color>
        <Color x:Key="Accent">#0B6E69</Color>
        <Color x:Key="AccentText">#FFFFFF</Color>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
            <Setter Property="TextColor" Value="{StaticResource AccentText}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
    </Application.Resources>
</Application>
