<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FieldOps.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:FieldOps.Core;assembly=FieldOps.Core"
    xmlns:app="clr-namespace:FieldOps.App"
    Title="Field inspections"
    BackgroundColor="{StaticResource Surface}">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label FontAttributes="Bold" FontSize="28" Text="FieldOps Offline" />
            <Label Text="Capture synthetic inspections without a network connection." />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
            <Label Text="Inspection title" />
            <Entry
                Grid.Row="1"
                AutomationId="inspection-title"
                Placeholder="North loading bay"
                SemanticProperties.Description="Required inspection title"
                Text="{Binding Title}" />
            <Label Grid.Column="1" Text="Notes" />
            <Editor
                Grid.Row="1"
                Grid.Column="1"
                AutomationId="inspection-notes"
                AutoSize="TextChanges"
                MaximumHeightRequest="120"
                MinimumHeightRequest="44"
                Placeholder="Describe the generated fixture"
                SemanticProperties.Description="Optional inspection notes"
                Text="{Binding Notes}" />
            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Spacing="12">
                <Button
                    AutomationId="save-offline"
                    Clicked="OnSaveClicked"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Text="Save offline" />
                <Button
                    AutomationId="sync-now"
                    Clicked="OnSyncClicked"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Text="Sync now" />
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="2" Padding="12" Stroke="#B8C4CA" StrokeShape="RoundRectangle 8">
            <Label
                AutomationId="sync-status"
                Text="{Binding StatusText}" />
        </Border>

        <CollectionView
            Grid.Row="3"
            AutomationId="inspection-history"
            EmptyView="No inspections yet. Save one while offline."
            ItemsSource="{Binding Inspections}">
            <CollectionView.Header>
                <VerticalStackLayout Margin="0,0,0,16" Spacing="12">
                    <Label FontAttributes="Bold" FontSize="20" Text="Resolve synchronization conflicts" />
                    <Label Text="Choose an unresolved inspection below. Review original, local and server values before saving. Review works offline; the next sync still checks server versions. Use synthetic data on an isolated development endpoint." />
                    <Picker
                        AutomationId="conflict-selector"
                        Title="Unresolved conflicts (up to 100; empty when none)"
                        ItemDisplayBinding="{Binding Local.Title}"
                        ItemsSource="{Binding Conflicts}"
                        SelectedItem="{Binding SelectedConflict, Mode=TwoWay}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <VerticalStackLayout IsVisible="{Binding HasConflictReview}" Spacing="12">
                        <Label Text="Matching and disjoint changes are preselected using the recorded base. Changed-on-both-sides fields require a choice. You may override any selection. Empty notes are a valid value." />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConflictFields}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="app:ConflictFieldChoice">
                                    <Border Padding="12" Stroke="#B8C4CA" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="6">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Text="Original base" FontAttributes="Bold" />
                                            <Label Text="{Binding BaselineValue}" />
                                            <Label Text="Your local value" FontAttributes="Bold" />
                                            <Label Text="{Binding LocalValue}" />
                                            <Label Text="Server value at conflict" FontAttributes="Bold" />
                                            <Label Text="{Binding RemoteValue}" />
                                            <Label Text="Both sides differ: choose a value." IsVisible="{Binding RequiresChoice}" />
                                            <Picker Title="Choose value to keep" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Button AutomationId="save-resolution" Text="Save resolution offline" Clicked="OnResolveClicked"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                            <Button AutomationId="cancel-resolution" Text="Cancel review" Clicked="OnCancelReviewClicked"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Label FontAttributes="Bold" FontSize="20" Text="Local inspections" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="domain:InspectionSnapshot">
                    <Border Margin="0,0,0,8" Padding="12" Stroke="#D5DEE2" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label FontAttributes="Bold" Text="{Binding Title}" />
                            <Label Grid.Column="1" Text="{Binding Status}" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Notes}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
